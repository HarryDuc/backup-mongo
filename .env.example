MONGODB_URI=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPLOAD_PATHS=

# Khóa mã hóa backup (AES-256-GCM) - BẮT BUỘC cho backup-telegram.cjs
# Dùng chuỗi bất kỳ, tối thiểu 16 ký tự
BACKUP_ENCRYPTION_KEY=

# Google Service Account (dùng cho backup-drive.cjs)
# Cách 1: đường dẫn tới file JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Cách 2: nội dung JSON inline (escape dấu nháy) hoặc base64
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Email service account (dùng để share folder)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Folder trên Drive đã share cho service account (lấy từ URL)
DRIVE_FOLDER_ID=
# Hoặc dùng tên folder (sẽ tự tìm/tạo nếu chưa có)
DRIVE_FOLDER_NAME=MongoDB Backups
# Scope (mặc định drive.file - chỉ truy cập file do app tạo)
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
# Nếu dùng domain-wide delegation, điền user để impersonate
GOOGLE_SUBJECT_USER=
# Chunk size cho Resumable Upload (bytes, mặc định 8MB)
DRIVE_CHUNK_SIZE=8388608
# Số bản backup giữ lại trên Drive
DRIVE_KEEP_COUNT=30
# Số bản backup giữ lại trên local
LOCAL_BACKUP_KEEP=30
